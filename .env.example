# Official GitHub Personal Access Token for real-time Contribution Activity (GitHub GraphQL API)
# Create at: https://github.com/settings/tokens
# Recommended scope: read:user (add `repo` if you also want private repository contributions counted)
# Add this to `.env.local` for local development AND to Vercel -> Project Settings -> Environment Variables.
GITHUB_TOKEN=

# Optional: override GitHub username (defaults to Seavik2142)
GITHUB_USERNAME=Seavik2142
